# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API).

# Safe to expose to the browser (anon client is for auth + realtime only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never import this into a client component or a user-facing
# route — it bypasses RLS. Used only by scripts/seed and admin tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
